# Copy this file to .env and fill in the values. Never commit .env.
# On Vercel, set these under Project Settings > Environment Variables.

# Resend API key used by api/send-email.js
RESEND_API_KEY=
# Where website enquiries are sent (defaults: info@palmsure.co.za and roy@palmsure.co.za)
PALMSURE_CONTACT_EMAIL=
PALMSURE_ADMIN_EMAIL=
